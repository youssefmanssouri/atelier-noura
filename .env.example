# ==============================================================================
# Atelier Noura — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# Application Public URL (used for canonical URLs, redirects, sitemap, and metadata)
# In production on Vercel, set this to your Vercel deployment URL (e.g. https://<project-name>.vercel.app)
APP_URL="http://localhost:3000"

# Optional Client-Facing Site URL override
# NEXT_PUBLIC_SITE_URL="https://<project-name>.vercel.app"

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In serverless/Vercel environments, use a pooled connection string (e.g. Neon, Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelier_noura?schema=public"

# Admin Session Secret (Minimum 32 characters, used to derive session HMAC/encryption keys)
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-32-char-min-secret-for-atelier-noura"

# Production Transactional Email Provider (Resend)
# Optional in development (uses dev console logger). Required for real delivery in production.
# Obtain API key from https://resend.com
RESEND_API_KEY="re_placeholder_secret_key"

# Outbound Notification Email Sender
# Without a custom domain on Resend, use the default testing sender: onboarding@resend.dev
EMAIL_FROM="Atelier Noura <onboarding@resend.dev>"

# Studio Inquiry Notification Recipient
INQUIRY_NOTIFICATION_EMAIL="contact@ateliernoura.ma"

# Initial Admin Provisioning (Used with: npm run db:seed:admin)
ADMIN_EMAIL="admin@ateliernoura.ma"
ADMIN_PASSWORD="change-this-to-a-secure-admin-password-min-10-chars"
ADMIN_NAME="Atelier Noura Admin"
